# Copy this file to backend/.env and fill in your own values. Never commit .env.

# testing: no sign-in, every Pro feature free, payments off, local data file (real database untouched).
# production: sign-in, payments and Pro checks; needs DATABASE_URL. Unset: production if DATABASE_URL is set.
# `npm run dev:testing` / `npm run start:production` override this.
APP_MODE=testing

# Neon connection string: Neon console > your project > Connect > copy the "Connection string".
# Use the pooled connection (host contains "-pooler") for an always-on API server.
# The backend talks to Neon over a WebSocket on port 443 (Neon serverless driver),
# so it works even on networks that block Postgres on port 5432.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

PORT=5000

# Google sign-in (optional). Google Cloud console > APIs & Services > Credentials >
# Create OAuth client ID (Web application). Add http://localhost:3000 to Authorised JavaScript origins.
GOOGLE_CLIENT_ID=

# Email for verification codes. Without any of these, codes are printed in the server console.
# On Render (free tier) and similar hosts, SMTP ports are blocked, so use an HTTP API key:
#   Brevo:  brevo.com > SMTP & API > API keys. Verify MAIL_FROM under Senders (a Gmail address works).
#   Resend: resend.com > API keys. Needs a verified domain in MAIL_FROM to email other people.
BREVO_API_KEY=
RESEND_API_KEY=
# SMTP fallback (works locally). Gmail: turn on 2-Step Verification, then create an App password at
# https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16 character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Daily Commit <you@gmail.com>"

# Razorpay payments for Pro (dashboard.razorpay.com → Account & Settings → API keys)
# Start with test keys (rzp_test_...). Live keys (rzp_live_...) take real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: Settings → Webhooks, URL https://YOUR_DOMAIN/api/billing/webhook,
# events payment.captured and order.paid, then paste the secret you chose here
RAZORPAY_WEBHOOK_SECRET=

# C++ and Java in the code editor run on Judge0 (JavaScript and Python run in the browser).
# RapidAPI: subscribe to Judge0 CE at https://rapidapi.com/judge0-official/api/judge0-ce (free tier
# has a daily limit) and paste the X-RapidAPI-Key here. Or set JUDGE0_URL to your own Judge0 server.
JUDGE0_API_KEY=
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# AI code score and analysis in the editor (Pro when accounts are on): complexity, the main idea, a better approach.
# Uses Google Gemini. Free API key (no card): https://aistudio.google.com/apikey
# The free tier allows only a few Flash requests per day for the whole project, so each person gets
# AI_REVIEW_DAILY_LIMIT reviews a day. Without a key, the score bar is hidden.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI_REVIEW_DAILY_LIMIT=30
