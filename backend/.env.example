# Copy this file to backend/.env and fill in your own values. Never commit .env.

# Neon connection string: Neon console > your project > Connect > copy the "Connection string".
# Use the pooled connection (host contains "-pooler") for an always-on API server.
# The backend talks to Neon over a WebSocket on port 443 (Neon serverless driver),
# so it works even on networks that block Postgres on port 5432.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

PORT=5000

# Google sign-in (optional). Google Cloud console > APIs & Services > Credentials >
# Create OAuth client ID (Web application). Add http://localhost:3000 to Authorised JavaScript origins.
GOOGLE_CLIENT_ID=

# Email for verification codes (SMTP). Without these, codes are printed in the server console.
# Gmail: turn on 2-Step Verification, then create an App password at https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16 character app password>
# Brevo, Resend, Mailgun and others work the same way with their SMTP details.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Daily Commit <you@gmail.com>"

# Razorpay payments for Pro (dashboard.razorpay.com → Account & Settings → API keys)
# Start with test keys (rzp_test_...). Live keys (rzp_live_...) take real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: Settings → Webhooks, URL https://YOUR_DOMAIN/api/billing/webhook,
# events payment.captured and order.paid, then paste the secret you chose here
RAZORPAY_WEBHOOK_SECRET=
